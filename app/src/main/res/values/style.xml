<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="BaseTextStyle">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:lineSpacingMultiplier">1.29</item>
        <item name="android:textStyle">normal</item>
        <item name="android:gravity">start</item>
    </style>

    <!--  Main 페이지  -->
    <style name="mainMovieTitleTextStyle">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="mainMovieScreeningDateTextStyle">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="mainMovieRunningTimeTextStyle">
        <item name="android:textSize">12sp</item>
    </style>

    <style name="mainMovieBookButtonTextStyle">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!--  Summary 페이지  -->
    <style name="summaryNotificationMessageTextStyle">
        <item name="android:textSize">15sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="summaryMovieTitleTextStyle">
        <item name="android:textSize">25sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="summaryMovieScreeningDateTimeTextStyle">
        <item name="android:textSize">20sp</item>
        <item name="android:gravity">center_horizontal</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="summaryMoviePeopleCountTextStyle">
        <item name="android:textSize">20sp</item>
        <item name="android:gravity">center_horizontal</item>
    </style>

    <style name="summaryMovieTotalAmountTextStyle">
        <item name="android:textSize">20sp</item>
        <item name="android:gravity">center_horizontal</item>
    </style>
</resources>
